# Bytecode. Regenerated on import, and 577 of these were tracked - every test
# run dirtied the tree with .pyc churn that had nothing to do with the change
# being reviewed. The vendored .tmp_pytest sources stay tracked; only its
# bytecode is ignored.
__pycache__/
*.py[cod]

# pytest's own scratch dir.
.pytest_cache/

# Secrets and keys. Nothing of the sort is tracked today or anywhere in the
# history - this list is a guard, not a cleanup. It has to be, because git is
# append-only: a key committed once survives in the history after it is
# deleted, and the only real fix is to rotate the key.
.env
.env.*
!.env.example
.envrc
.netrc
.pypirc
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials.json
service-account*.json
.aws/
.ssh/
.gnupg/

# Per-developer tool state. Local permission grants, machine paths and editor
# layout - configuration of a machine, not of Marrow, and the local settings
# file in particular is where a tool will happily write an API key.
.claude/settings.local.json
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Local Python environments. Blender runs the addon against its own bundled
# interpreter, so a venv here is only ever a scratch tool - it should never
# reach the package, and it is large enough to be worth never staging.
.venv/
venv/
*.egg-info/

# OS and file-manager droppings. They carry local paths and thumbnails and
# have nothing to do with the addon.
.DS_Store
._*
Thumbs.db
desktop.ini

# Blender autosave backups. Written beside any .blend the moment it is saved
# again, and they are pure duplicates - the .blend1 already tracked stays
# tracked, since ignoring a path does not untrack it.
*.blend1
*.blend2
